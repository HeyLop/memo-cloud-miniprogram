/* v2 双色主题：工作蓝 / 生活暖。所有页面颜色引用变量，class 名一律 ASCII。 */
page {
    --brand: #1769e0;
    --brand-soft: #eaf2ff;
    --page-bg: #f5f8ff;
    --card-bg: #ffffff;
    --text-main: #1f2329;
    --text-muted: #646a73;
    --border: #e5e8eb;
    --danger: #d54941;
    background: var(--page-bg);
    color: var(--text-main);
    font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", sans-serif;
}

/* 生活分区：根 view 加 zone-life 类即可整体变色 */
.zone-life {
    --brand: #d9730d;
    --brand-soft: #fff2e4;
    --page-bg: #fff8f0;
    --card-bg: #ffffff;
    --border: #f0e2d2;
    background: var(--page-bg);
}

button {
    border-radius: 12rpx;
}
