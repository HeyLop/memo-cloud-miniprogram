<view class="page">
    <view class="field">
        <text class="label">标题</text>
        <input class="input title-input" value="{{title}}" placeholder="例如：周五前提交方案" bindinput="onTitleInput" />
    </view>

    <view class="field">
        <text class="label">内容</text>
        <textarea class="input textarea" value="{{content}}" placeholder="补充细节、步骤、注意事项…" bindinput="onContentInput" />
    </view>

    <view class="field">
        <text class="label">分类</text>
        <view class="chip-row">
            <text
                class="chip {{category === item ? 'chip-active' : ''}}"
                wx:for="{{categories}}"
                wx:key="*this"
                data-value="{{item}}"
                bindtap="onCategoryTap"
            >{{item}}</text>
        </view>
    </view>

    <view class="field">
        <text class="label">优先级</text>
        <view class="chip-row">
            <text
                class="chip {{priority === item ? 'chip-active' : ''}}"
                wx:for="{{priorities}}"
                wx:key="*this"
                data-value="{{item}}"
                bindtap="onPriorityTap"
            >{{item}}</text>
        </view>
    </view>

    <view class="field">
        <text class="label">提醒时间（可选）</text>
        <view class="date-row">
            <picker mode="date" value="{{dueDate}}" bindchange="onDateChange">
                <view class="picker-box">{{dueDate || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{dueTime}}" bindchange="onTimeChange">
                <view class="picker-box">{{dueTime || '09:00'}}</view>
            </picker>
        </view>
        <text class="hint">设置后，到期当天会在「今日提醒」中置顶显示</text>
    </view>

    <button class="save-button" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存</button>
    <button class="delete-button" wx:if="{{id}}" bindtap="onDelete">删除这条备忘</button>
</view>
