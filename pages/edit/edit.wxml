<view class="page {{zone === 'life' ? 'zone-life' : ''}}">
    <view class="field">
        <text class="label">标题</text>
        <input class="input title-input" value="{{title}}" placeholder="要做什么？" bindinput="onTitleInput" />
    </view>

    <view class="field">
        <text class="label">内容</text>
        <textarea class="input textarea" value="{{content}}" placeholder="补充细节、步骤…" bindinput="onContentInput" />
    </view>

    <view class="field">
        <text class="label">分区</text>
        <view class="chip-row">
            <text class="chip {{zone === 'work' ? 'chip-active' : ''}}" data-zone="work" bindtap="onZoneTap">工作</text>
            <text class="chip {{zone === 'life' ? 'chip-active' : ''}}" data-zone="life" bindtap="onZoneTap">生活</text>
        </view>
    </view>

    <view class="field">
        <text class="label">优先级</text>
        <view class="chip-row">
            <text
                class="chip {{priority === item.value ? 'chip-active' : ''}}"
                wx:for="{{priorities}}"
                wx:key="value"
                data-value="{{item.value}}"
                bindtap="onPriorityTap"
            >{{item.label}}</text>
        </view>
    </view>

    <view class="field">
        <text class="label">截止时间（用于今日提醒）</text>
        <view class="date-row">
            <picker mode="date" value="{{dueDate}}" bindchange="onDateChange">
                <view class="picker">{{dueDate || '选择日期'}}</view>
            </picker>
            <picker mode="time" value="{{dueTime}}" bindchange="onTimeChange">
                <view class="picker">{{dueTime || '选择时间'}}</view>
            </picker>
        </view>
    </view>

    <button class="save-button" bindtap="onSave" loading="{{saving}}" disabled="{{saving}}">保存</button>
    <text class="delete-link" wx:if="{{id}}" bindtap="onDelete">删除这条待办</text>
</view>
