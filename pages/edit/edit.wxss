.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 32rpx;
}

.field {
    margin-bottom: 36rpx;
}

.label {
    display: block;
    margin-bottom: 16rpx;
    color: #646a73;
    font-size: 26rpx;
}

.input {
    box-sizing: border-box;
    width: 100%;
    padding: 24rpx;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 16rpx;
    font-size: 30rpx;
}

.title-input {
    height: 88rpx;
}

.textarea {
    min-height: 200rpx;
    line-height: 1.6;
}

.chip-row {
    display: flex;
    flex-wrap: wrap;
}

.chip {
    padding: 14rpx 32rpx;
    margin: 0 16rpx 16rpx 0;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 40rpx;
    color: #646a73;
    font-size: 26rpx;
}

.chip-active {
    background: #eaf2ff;
    border-color: #1769e0;
    color: #1769e0;
}

.date-row {
    display: flex;
}

.picker-box {
    box-sizing: border-box;
    min-width: 240rpx;
    padding: 20rpx 24rpx;
    margin-right: 16rpx;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 12rpx;
    font-size: 28rpx;
}

.hint {
    display: block;
    margin-top: 14rpx;
    color: #8a9099;
    font-size: 22rpx;
    line-height: 1.5;
}

.save-button {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 32rpx;
    border-radius: 16rpx;
}

.delete-button {
    width: 100%;
    height: 88rpx;
    line-height: 88rpx;
    margin-top: 24rpx;
    background: #ffffff;
    color: #d54941;
    font-size: 30rpx;
    border-radius: 16rpx;
}
