<view class="page">
    <view class="hero">
        <text class="eyebrow">MEMO · CLOUD</text>
        <text class="title">清单备忘</text>
        <text class="subtitle">工作提醒 · 云端同步 · 可分享</text>
    </view>

    <view class="state-card" wx:if="{{authState === 'checking'}}">
        <view class="spinner"></view>
        <text class="state-title">正在检查登录状态</text>
    </view>

    <view class="state-card" wx:elif="{{authState === 'signed-out'}}">
        <text class="empty-icon">○</text>
        <text class="state-title">登录后查看你的备忘</text>
        <text class="state-description">微信一键登录，数据保存在云端、跨设备同步。</text>
        <button class="primary-button" bindtap="onWechatLogin" loading="{{wechatLoggingIn}}" disabled="{{wechatLoggingIn || loggingIn}}">微信一键登录</button>
        <text class="backup-login" bindtap="onLogin" wx:if="{{!wechatLoggingIn && !loggingIn}}">改用 WorkBuddy 账号登录</text>
        <text class="error-text" wx:if="{{loginError}}">{{loginError}}</text>
    </view>

    <block wx:else>
        <view class="top-bar">
            <text class="user-name">{{user.name || '已登录用户'}}</text>
            <view class="top-actions">
                <text class="link" bindtap="onOpenShared">共享备忘</text>
                <text class="link" bindtap="onLogout">退出</text>
            </view>
        </view>

        <view class="today-card" wx:if="{{todayNotes.length > 0}}">
            <view class="today-head">
                <text class="today-title">今日提醒</text>
                <text class="today-count">{{todayNotes.length}} 条待处理</text>
            </view>
            <view class="today-item" wx:for="{{todayNotes}}" wx:key="id">
                <view class="today-item-main">
                    <text class="today-item-title">{{item.title}}</text>
                    <text class="today-item-time">{{item.dueText}} · {{item.priority}}优先级</text>
                </view>
                <text class="go" data-id="{{item.id}}" bindtap="onEdit">查看</text>
            </view>
        </view>

        <view class="filter-row">
            <text
                class="filter-chip {{filter === item ? 'filter-active' : ''}}"
                wx:for="{{filters}}"
                wx:key="*this"
                data-value="{{item}}"
                bindtap="onFilterTap"
            >{{item}}</text>
        </view>

        <text class="error-text" wx:if="{{loadError}}">{{loadError}}</text>

        <view class="list-card" wx:if="{{allNotes.length > 0}}">
            <view class="note-item" wx:for="{{allNotes}}" wx:key="id" wx:if="{{filter === '全部' || item.category === filter}}">
                <view class="check {{item.done ? 'check-done' : ''}}" data-id="{{item.id}}" bindtap="onToggleDone">{{item.done ? '✓' : ''}}</view>
                <view class="note-main" data-id="{{item.id}}" bindtap="onEdit">
                    <view class="note-head">
                        <text class="note-title {{item.done ? 'title-done' : ''}}">{{item.title}}</text>
                        <text class="priority-badge {{item.priorityClass}}">{{item.priority}}</text>
                    </view>
                    <text class="note-content" wx:if="{{item.content}}">{{item.content}}</text>
                    <view class="note-meta">
                        <text class="meta-item">{{item.category}}</text>
                        <text class="meta-item" wx:if="{{item.dueText}}">⏰ {{item.dueText}}</text>
                    </view>
                </view>
                <text class="share-link" data-id="{{item.id}}" bindtap="onShare">分享</text>
            </view>
        </view>

        <view class="empty-card" wx:else>
            <text class="empty-icon">○</text>
            <text class="empty-title">还没有备忘</text>
            <text class="empty-desc">点下方「新建备忘」创建第一条。</text>
        </view>

        <button class="add-fab" bindtap="onAdd">+ 新建备忘</button>
    </block>
</view>
