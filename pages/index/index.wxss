.page {
    box-sizing: border-box;
    min-height: 100vh;
    padding: 48rpx 32rpx 160rpx;
}

.hero {
    display: flex;
    flex-direction: column;
    margin-bottom: 28rpx;
}

.eyebrow {
    color: #1769e0;
    font-size: 22rpx;
    font-weight: 600;
    letter-spacing: 3rpx;
}

.title {
    margin-top: 16rpx;
    font-size: 52rpx;
    font-weight: 700;
    line-height: 1.25;
}

.subtitle {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 26rpx;
}

.state-card {
    display: flex;
    min-height: 360rpx;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    text-align: center;
}

.spinner {
    width: 48rpx;
    height: 48rpx;
    border: 6rpx solid #dbe8fb;
    border-top-color: #1769e0;
    border-radius: 50%;
}

.state-title {
    margin-top: 24rpx;
    font-size: 34rpx;
    font-weight: 600;
}

.state-description {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 26rpx;
    line-height: 1.6;
}

.primary-button {
    margin-top: 32rpx;
    width: 460rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 30rpx;
    border-radius: 12rpx;
}

.backup-login {
    margin-top: 24rpx;
    color: #1769e0;
    font-size: 24rpx;
}

.error-text {
    display: block;
    margin: 16rpx 0;
    color: #d54941;
    font-size: 24rpx;
    line-height: 1.5;
}

.empty-icon {
    color: #1769e0;
    font-size: 64rpx;
}

.top-bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 18rpx 24rpx;
    margin-bottom: 20rpx;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 16rpx;
}

.user-name {
    font-size: 26rpx;
    color: #1f2329;
}

.top-actions {
    display: flex;
}

.link {
    margin-left: 24rpx;
    color: #1769e0;
    font-size: 24rpx;
}

.today-card {
    box-sizing: border-box;
    padding: 28rpx;
    margin-bottom: 24rpx;
    background: #fff8ec;
    border: 2rpx solid #f5dcae;
    border-radius: 20rpx;
}

.today-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 16rpx;
    border-bottom: 2rpx solid #f0e0c0;
}

.today-title {
    font-size: 30rpx;
    font-weight: 600;
    color: #a85d00;
}

.today-count {
    font-size: 22rpx;
    color: #a85d00;
}

.today-item {
    display: flex;
    align-items: center;
    padding: 18rpx 0;
    border-bottom: 2rpx solid #f5e8cf;
}

.today-item:last-child {
    border-bottom: none;
}

.today-item-main {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.today-item-title {
    font-size: 28rpx;
    color: #1f2329;
}

.today-item-time {
    margin-top: 6rpx;
    font-size: 22rpx;
    color: #a85d00;
}

.go {
    margin-left: 16rpx;
    color: #a85d00;
    font-size: 24rpx;
}

.filter-row {
    display: flex;
    flex-wrap: wrap;
    margin-bottom: 20rpx;
}

.filter-chip {
    padding: 12rpx 28rpx;
    margin: 0 14rpx 14rpx 0;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 40rpx;
    color: #646a73;
    font-size: 24rpx;
}

.filter-active {
    background: #eaf2ff;
    border-color: #1769e0;
    color: #1769e0;
}

.list-card {
    box-sizing: border-box;
    padding: 12rpx 28rpx;
    background: #ffffff;
    border: 2rpx solid #e5e8eb;
    border-radius: 20rpx;
}

.note-item {
    display: flex;
    align-items: flex-start;
    padding: 24rpx 0;
    border-bottom: 2rpx solid #f0f1f2;
}

.note-item:last-child {
    border-bottom: none;
}

.check {
    display: flex;
    flex-shrink: 0;
    width: 40rpx;
    height: 40rpx;
    margin-top: 4rpx;
    margin-right: 20rpx;
    align-items: center;
    justify-content: center;
    border: 3rpx solid #c4c9d0;
    border-radius: 50%;
    color: #ffffff;
    font-size: 24rpx;
}

.check-done {
    background: #1d9e75;
    border-color: #1d9e75;
}

.note-main {
    display: flex;
    flex: 1;
    flex-direction: column;
}

.note-head {
    display: flex;
    align-items: center;
}

.note-title {
    flex: 1;
    font-size: 30rpx;
    font-weight: 600;
    color: #1f2329;
    line-height: 1.4;
}

.title-done {
    color: #8a9099;
    text-decoration: line-through;
}

.priority-badge {
    padding: 4rpx 14rpx;
    font-size: 20rpx;
    border-radius: 20rpx;
    color: #ffffff;
}

.priority-high {
    background: #d54941;
}

.priority-normal {
    background: #8a9099;
}

.priority-low {
    background: #1d9e75;
}

.note-content {
    margin-top: 10rpx;
    color: #646a73;
    font-size: 25rpx;
    line-height: 1.6;
}

.note-meta {
    display: flex;
    margin-top: 12rpx;
}

.meta-item {
    margin-right: 20rpx;
    color: #8a9099;
    font-size: 22rpx;
}

.share-link {
    flex-shrink: 0;
    margin-left: 16rpx;
    margin-top: 4rpx;
    color: #1769e0;
    font-size: 24rpx;
}

.empty-card {
    display: flex;
    min-height: 300rpx;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    text-align: center;
}

.empty-title {
    margin-top: 16rpx;
    font-size: 32rpx;
    font-weight: 600;
}

.empty-desc {
    margin-top: 12rpx;
    color: #646a73;
    font-size: 26rpx;
}

.add-fab {
    position: fixed;
    left: 32rpx;
    right: 32rpx;
    bottom: 40rpx;
    height: 88rpx;
    line-height: 88rpx;
    background: #1769e0;
    color: #ffffff;
    font-size: 32rpx;
    border-radius: 44rpx;
}
